# Development mode - SQLite (no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./data/videofactory.db

# Application
APP_NAME=视界短视频工坊
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-in-production-please

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Zhipu Video Generation (CogVideoX) — 同时用作 LLM 回退供应商
ZHIPU_API_KEY=your-zhipu-api-key-here

# 备选AI供应商（DeepSeek 失败时自动回退）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2024

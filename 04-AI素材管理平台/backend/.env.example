# Development mode - SQLite (no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./data/rag_system.db

# Application
APP_NAME=图库资产管家
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-in-production-please

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 外部图库 API（可选，不配置则仅使用免费图库 Lorem Picsum）
# Unsplash: 注册 https://unsplash.com/developers 免费获取 Access Key
UNSPLASH_API_KEY=
# Pexels: 注册 https://www.pexels.com/api 免费获取 API Key
PEXELS_API_KEY=

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3004"]

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2024

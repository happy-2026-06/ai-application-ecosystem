<template>
  <div class="studio-page">
    <!-- 左侧: 创作需求输入 -->
    <aside class="studio-sidebar">
      <div class="sidebar-header">
        <h2>🎬 脚本工坊</h2>
        <p>输入产品信息，AI 生成可拍摄的分镜脚本</p>
      </div>

      <div class="input-section">
        <label class="section-label">📦 产品信息</label>
        <n-input
          v-model:value="productName"
          placeholder="产品名称，如：智能蓝牙耳机"
          :disabled="isLoading"
        />
      </div>

      <div class="input-section">
        <label class="section-label">✨ 核心卖点</label>
        <n-input
          v-model:value="sellingPoints"
          type="textarea"
          placeholder="每个卖点一行，如：&#10;降噪40dB，地铁也能安静听歌&#10;续航30小时，一周充一次&#10;蓝牙5.3，连接快又稳"
          :autosize="{ minRows: 3, maxRows: 5 }"
          :disabled="isLoading"
        />
      </div>

      <div class="input-section">
        <label class="section-label">💰 价格（可选）</label>
        <n-input
          v-model:value="price"
          placeholder="如：¥299"
          :disabled="isLoading"
        />
      </div>

      <div class="input-section">
        <label class="section-label">🎭 模板风格</label>
        <n-radio-group v-model:value="templateStyle">
          <n-space vertical>
            <n-radio value="带货" label="🛍️ 带货类 — 痛点前置+卖点演示+价格锚点" />
            <n-radio value="测评" label="📊 测评对比类 — 产品对比+实测数据+结论推荐" />
            <n-radio value="开箱" label="📦 沉浸开箱类 — 悬念+开箱过程+第一视角" />
          </n-space>
        </n-radio-group>
      </div>

      <div class="input-section">
        <label class="section-label">📱 目标平台</label>
        <n-select
          v-model:value="targetPlatform"
          :options="platformOptions"
          placeholder="选择主要平台"
        />
      </div>

      <n-button
        type="primary"
        block
        size="large"
        :loading="isLoading"
        :disabled="!productName.trim()"
        @click="handleGenerate"
        style="margin-top: 16px;"
      >
        🎥 生成分镜脚本
      </n-button>

      <div class="quick-templates">
        <label class="section-label">⚡ 快捷填充</label>
        <n-space vertical>
          <n-button text @click="quickFill('充电宝', '20000mAh大容量\n支持快充\n小巧便携', '¥99', '带货')">🔋 充电宝带货</n-button>
          <n-button text @click="quickFill('蓝牙耳机', '主动降噪\n30h续航\nHiFi音质', '¥299', '测评')">🎧 耳机测评</n-button>
          <n-button text @click="quickFill('智能手表', '健康监测\n运动模式\n7天续航', '¥599', '开箱')">⌚ 手表开箱</n-button>
        </n-space>
      </div>
    </aside>

    <!-- 右侧: 结果展示 -->
    <main class="studio-main">
      <div v-if="!resultContent && !isLoading" class="studio-empty">
        <div class="empty-icon">🎬</div>
        <h1>AI 短视频脚本工坊</h1>
        <p>输入产品信息，选择模板风格和目标平台，AI 帮你生成可直接拍摄的专业分镜脚本</p>
        <div class="feature-cards">
          <div class="feature-card">
            <div class="fc-icon">📋</div>
            <div class="fc-title">分镜表</div>
            <div class="fc-desc">镜号/时长/画面/口播</div>
          </div>
          <div class="feature-card">
            <div class="fc-icon">🎤</div>
            <div class="fc-title">口播稿</div>
            <div class="fc-desc">完整逐字文案</div>
          </div>
          <div class="feature-card">
            <div class="fc-icon">🎥</div>
            <div class="fc-title">拍摄建议</div>
            <div class="fc-desc">B-roll/转场/字幕</div>
          </div>
          <div class="feature-card">
            <div class="fc-icon">📊</div>
            <div class="fc-title">平台适配</div>
            <div class="fc-desc">5平台差异化建议</div>
          </div>
        </div>
      </div>

      <div v-else-if="isLoading" class="studio-loading">
        <div class="loading-icon">🎥</div>
        <h3>AI 正在编排分镜…</h3>
        <p>{{ loadingHint }}</p>
        <div v-if="streamingContent" class="streaming-preview">
          <div v-html="renderMd(streamingContent)" class="md-content" />
        </div>
      </div>

      <div v-else class="studio-result">
        <div class="result-toolbar">
          <h3>📋 生成结果</h3>
          <n-space>
            <n-button size="small" @click="copyAll">📋 复制全部</n-button>
            <n-button size="small" @click="exportMD">⬇ 导出 Markdown</n-button>
            <n-button size="small" @click="handleRegenerate">🔄 重新生成</n-button>
          </n-space>
        </div>
        <div class="result-scroll">
          <div v-html="renderMd(resultContent)" class="md-content" />
        </div>
      </div>
    </main>
  </div>
</template>

<script setup lang="ts">
import { ref, onUnmounted } from 'vue'
import { useMessage } from 'naive-ui'
import MarkdownIt from 'markdown-it'
import { chatApi } from '../api/chat'
import { useAuthStore } from '../stores/auth'

const message = useMessage()
const authStore = useAuthStore()

const LOADING_HINTS = [
  '正在分析产品卖点…',
  '匹配最佳分镜模板中…',
  '编排镜头顺序…',
  '撰写口播文案…',
  '优化拍摄建议…',
  '生成平台适配方案…',
]

const productName = ref('')
const sellingPoints = ref('')
const price = ref('')
const templateStyle = ref('带货')
const targetPlatform = ref('抖音')
const isLoading = ref(false)
const resultContent = ref('')
const streamingContent = ref('')
const loadingHint = ref('')
let hintTimer: ReturnType<typeof setInterval> | null = null

const platformOptions = [
  { label: '抖音', value: '抖音' },
  { label: '小红书', value: '小红书' },
  { label: 'B站', value: 'B站' },
  { label: '视频号', value: '视频号' },
  { label: '快手', value: '快手' },
]

const md = new MarkdownIt({ html: false, linkify: true, breaks: true })
function renderMd(t: string) { return t ? md.render(t) : '' }

function quickFill(name: string, points: string, p: string, style: string) {
  productName.value = name
  sellingPoints.value = points
  price.value = p
  templateStyle.value = style
}

async function handleGenerate() {
  if (!productName.value.trim() || isLoading.value) return

  isLoading.value = true
  streamingContent.value = ''
  resultContent.value = ''

  let hintIndex = 0
  loadingHint.value = LOADING_HINTS[0]
  hintTimer = setInterval(() => {
    hintIndex = (hintIndex + 1) % LOADING_HINTS.length
    loadingHint.value = LOADING_HINTS[hintIndex]
  }, 2000)

  try {
    const parts = [`产品: ${productName.value}`]
    if (sellingPoints.value.trim()) parts.push(`核心卖点:\n${sellingPoints.value}`)
    if (price.value.trim()) parts.push(`价格: ${price.value}`)
    parts.push(`模板风格: ${templateStyle.value}`)
    parts.push(`目标平台: ${targetPlatform.value}`)
    const fullQuestion = parts.join('\n\n')

    const response = await chatApi.askQuestion('script-studio', fullQuestion, authStore.token)
    if (!response.ok) throw new Error(`HTTP ${response.status}`)

    const reader = response.body?.getReader()
    if (!reader) throw new Error('Response body is not readable')

    const decoder = new TextDecoder()
    let buffer = ''

    while (true) {
      const { done, value } = await reader.read()
      if (done) break
      buffer += decoder.decode(value, { stream: true })
      const lines = buffer.split('\n')
      buffer = lines.pop() || ''
      for (const line of lines) {
        if (!line.startsWith('data: ')) continue
        const data = line.slice(6)
        if (data === '[DONE]') continue
        try {
          const event = JSON.parse(data)
          if (event.type === 'token') {
            streamingContent.value += event.content || ''
          } else if (event.type === 'done') {
            resultContent.value = event.data?.full_answer || streamingContent.value
          }
        } catch { /* skip malformed chunks */ }
      }
    }
  } catch (e: any) {
    message.error('生成失败: ' + (e.message || '请重试'))
    if (streamingContent.value && !resultContent.value) {
      resultContent.value = streamingContent.value
    }
    if (!resultContent.value) {
      resultContent.value = '抱歉，分镜脚本生成失败，请重试。'
    }
  } finally {
    isLoading.value = false
    if (hintTimer) { clearInterval(hintTimer); hintTimer = null }
  }
}

function copyAll() {
  if (!resultContent.value) return
  navigator.clipboard.writeText(resultContent.value).then(() => message.success('已复制全部内容'))
}

function exportMD() {
  if (!resultContent.value) return
  const blob = new Blob([resultContent.value], { type: 'text/markdown' })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = `分镜脚本_${productName.value}_${new Date().toISOString().slice(0, 10)}.md`
  a.click()
  URL.revokeObjectURL(url)
  message.success('已导出')
}

function handleRegenerate() {
  resultContent.value = ''
  streamingContent.value = ''
  handleGenerate()
}

onUnmounted(() => {
  if (hintTimer) clearInterval(hintTimer)
})
</script>

<style scoped>
.studio-page { display: flex; height: 100%; }

.studio-sidebar {
  width: 320px; min-width: 320px; padding: 20px;
  background: #f8f9fb; border-right: 1px solid #eef0f4;
  display: flex; flex-direction: column; gap: 4px;
  overflow-y: auto;
}
.sidebar-header { margin-bottom: 8px; }
.sidebar-header h2 { margin: 0; font-size: 18px; font-weight: 700; color: #1a1a2e; }
.sidebar-header p { margin: 4px 0 0; font-size: 13px; color: #999; }
.input-section { margin-top: 14px; }
.section-label { display: block; font-size: 13px; font-weight: 600; color: #555; margin-bottom: 6px; }
.quick-templates { margin-top: 20px; padding-top: 16px; border-top: 1px solid #eef0f4; }

.studio-main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #fff; }

.studio-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 40px; text-align: center;
}
.empty-icon { font-size: 64px; margin-bottom: 16px; }
.studio-empty h1 { font-size: 26px; font-weight: 700; margin: 0 0 8px; color: #1a1a2e; }
.studio-empty p { color: #888; margin: 0 0 32px; max-width: 440px; }
.feature-cards { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.feature-card {
  padding: 16px 20px; background: #f5f6fa; border-radius: 12px;
  text-align: center; min-width: 120px; transition: all .2s;
}
.feature-card:hover { background: #eef0f8; transform: translateY(-2px); }
.fc-icon { font-size: 28px; margin-bottom: 4px; }
.fc-title { font-size: 14px; font-weight: 600; color: #333; }
.fc-desc { font-size: 12px; color: #999; margin-top: 2px; }

.studio-loading { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; }
.loading-icon { font-size: 48px; animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
.studio-loading h3 { margin: 12px 0 6px; font-size: 18px; color: #333; }
.studio-loading p { color: #999; font-size: 14px; margin: 0 0 20px; }
.streaming-preview { width: 100%; max-width: 820px; max-height: 60vh; overflow-y: auto; }

.studio-result { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.result-toolbar {
  padding: 14px 24px; border-bottom: 1px solid #f0f0f0;
  display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
}
.result-toolbar h3 { margin: 0; font-size: 16px; font-weight: 600; }
.result-scroll { flex: 1; overflow-y: auto; padding: 24px 32px; }

.md-content { max-width: 820px; margin: 0 auto; font-size: 15px; line-height: 1.85; color: #1e1e2e; }
.md-content :deep(h1), .md-content :deep(h2), .md-content :deep(h3) { margin: 18px 0 8px; font-weight: 700; }
.md-content :deep(h2) { font-size: 18px; border-bottom: 2px solid #e8ecf8; padding-bottom: 6px; }
.md-content :deep(h3) { font-size: 16px; }
.md-content :deep(p) { margin: 0 0 10px; }
.md-content :deep(strong) { font-weight: 700; }
.md-content :deep(ul), .md-content :deep(ol) { margin: 6px 0; padding-left: 20px; }
.md-content :deep(li) { margin: 3px 0; }
.md-content :deep(table) { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 14px; }
.md-content :deep(th) { background: #eef0f8; padding: 8px 12px; text-align: left; font-weight: 600; border: 1px solid #e0e3ee; }
.md-content :deep(td) { padding: 8px 12px; border: 1px solid #e8ecf4; }
.md-content :deep(tr:nth-child(even)) { background: #fafbfd; }
.md-content :deep(code) { background: #eef0f8; padding: 2px 6px; border-radius: 4px; font-size: 13px; font-family: "Cascadia Code","Fira Code",Consolas,monospace; }
.md-content :deep(pre) { background: #1e1e2e; color: #cdd6f4; padding: 14px; border-radius: 10px; overflow-x: auto; margin: 8px 0; }
.md-content :deep(pre code) { background: transparent; padding: 0; color: inherit; }
.md-content :deep(blockquote) { border-left: 3px solid #ff6b6b; padding: 6px 12px; margin: 8px 0; background: #fef0f0; border-radius: 0 8px 8px 0; color: #666; }

.result-scroll::-webkit-scrollbar, .streaming-preview::-webkit-scrollbar { width: 5px; }
.result-scroll::-webkit-scrollbar-thumb, .streaming-preview::-webkit-scrollbar-thumb { background: #ddd; border-radius: 5px; }

[data-theme="dark"] .studio-sidebar { background: #16161d; border-right-color: #222; }
[data-theme="dark"] .sidebar-header h2 { color: #eee; }
[data-theme="dark"] .sidebar-header p { color: #777; }
[data-theme="dark"] .section-label { color: #aaa; }
[data-theme="dark"] .quick-templates { border-top-color: #2a2a38; }
[data-theme="dark"] .studio-main { background: #101014; }
[data-theme="dark"] .studio-empty h1 { color: #eee; }
[data-theme="dark"] .studio-empty p { color: #888; }
[data-theme="dark"] .feature-card { background: #1e1e28; }
[data-theme="dark"] .feature-card:hover { background: #282838; }
[data-theme="dark"] .fc-title { color: #ddd; }
[data-theme="dark"] .studio-loading h3 { color: #ddd; }
[data-theme="dark"] .result-toolbar { border-bottom-color: #222; }
[data-theme="dark"] .result-toolbar h3 { color: #eee; }
[data-theme="dark"] .md-content { color: #d8d8e8; }
[data-theme="dark"] .md-content :deep(h2) { border-bottom-color: #333; color: #eee; }
[data-theme="dark"] .md-content :deep(th) { background: #222; border-color: #333; }
[data-theme="dark"] .md-content :deep(td) { border-color: #2a2a38; }
[data-theme="dark"] .md-content :deep(tr:nth-child(even)) { background: #15151e; }
[data-theme="dark"] .md-content :deep(code) { background: #222; }
[data-theme="dark"] .md-content :deep(blockquote) { background: #1a1a1a; }
</style>
